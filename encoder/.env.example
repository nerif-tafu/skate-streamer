# Copy to encoder/.env on the Pi. install-systemd-skate-streamer.sh runs:
#   node --env-file=.../encoder/.env .../encoder.js

MONITOR_RECEIVER_WS_URL=ws://127.0.0.1:9090/ingest
# Camera + upstream frame rate; receiver recording uses this value from the hello handshake (default 30).
MONITOR_VIDEO_FPS=30
# Legacy alias: MONITOR_CAMERA_FPS
MONITOR_AUDIO_ENABLED=true
# auto = scan `arecord -l` (recommended; card numbers change after reboot)
# Or set e.g. hw:1,0 — that device is still tried first, then fallbacks
MONITOR_AUDIO_DEVICE=auto
# Optional: substring of the capture card line from arecord -l (e.g. Streamer, USB Audio)
# MONITOR_AUDIO_DEVICE_MATCH=Streamer
