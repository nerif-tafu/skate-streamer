# Copy to reciever/.env for `npm start` and for systemd (install-systemd-skate-streamer.sh passes
# `node --env-file=.../reciever/.env`). Encoder settings live in encoder/.env — not read by the receiver.

MONITOR_HOST=0.0.0.0
MONITOR_PORT=9090

# Local default: ./recordings. In Docker, mount a volume on /data and use:
# MONITOR_RECORDINGS_DIR=/data/recordings
MONITOR_RECORDINGS_DIR=

MONITOR_RECORDING_FPS=15
MONITOR_FFMPEG_PATH=ffmpeg

MONITOR_GOOGLE_CLIENT_ID=
MONITOR_ADMIN_ALLOWED_EMAILS=you@example.com
MONITOR_ADMIN_SESSION_TTL_MS=43200000

MONITOR_INGEST_PATH=/ingest
MONITOR_SUBSCRIBER_MAX_BUFFER_BYTES=524288
MONITOR_CAMERA_STALE_MS=2500
MONITOR_GPS_STALE_MS=4500
MONITOR_CONTROL_LOCK_MS=5000
