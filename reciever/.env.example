# Copy to reciever/.env for `npm start` on the server that runs the receiver.
# The Pi install script install-systemd-skate-streamer.sh only installs the encoder and uses encoder/.env.

MONITOR_HOST=0.0.0.0
MONITOR_PORT=9090

# Local default: ./recordings. In Docker, mount a volume on /data and use:
# MONITOR_RECORDINGS_DIR=/data/recordings
MONITOR_RECORDINGS_DIR=

# Optional: recording ffmpeg framerate if encoder has not sent hello yet (e.g. stream on at boot).
# Normally the encoder sends cameraFps in its WebSocket hello — set MONITOR_VIDEO_FPS on the Pi only.
# MONITOR_VIDEO_FPS=30
# Legacy alias: MONITOR_RECORDING_FPS
MONITOR_FFMPEG_PATH=ffmpeg

MONITOR_GOOGLE_CLIENT_ID=
MONITOR_ADMIN_ALLOWED_EMAILS=you@example.com
MONITOR_ADMIN_SESSION_TTL_MS=43200000

MONITOR_INGEST_PATH=/ingest
MONITOR_SUBSCRIBER_MAX_BUFFER_BYTES=524288
MONITOR_CAMERA_STALE_MS=2500
MONITOR_GPS_STALE_MS=4500
MONITOR_CONTROL_LOCK_MS=5000
